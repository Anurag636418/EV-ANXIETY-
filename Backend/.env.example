APP_NAME="Intelligent EV Trip Planner API"
APP_ENV="development"
FRONTEND_ORIGINS="http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001"

# --- Charging Station Discovery (Sprint 3) ---
# Optional: get a free key at https://openchargemap.org/site/develop/api
# The app works anonymously at low volume; a key increases rate limits.
OPENCHARGERMAP_API_KEY=""
# Search radius in km around each sampled waypoint (default: 5.0)
CHARGING_SEARCH_RADIUS_KM=5.0
# Max waypoints sampled along the route for OCM queries (default: 10)
CHARGING_MAX_WAYPOINTS=10
